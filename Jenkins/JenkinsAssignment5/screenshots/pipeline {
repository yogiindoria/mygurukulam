pipeline {
    agent { label 'demoserver' }

    stages {
        stage('Clean Disk Space & Caches') {
            steps {
                sh '''
                echo "=========================================="
                echo "0. Freeing Up Disk Space & Cleaning Caches"
                echo "=========================================="
                sudo apt-get clean
                sudo apt-get autoremove --purge -y || true
                rm -rf ~/.cache/pip ~/.cache/pypoetry || true
                find /tmp -user "$(whoami)" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
                '''
            }
        }

        stage('Gitleaks Credential Scan') {
            steps {
                sh '''
                echo "=========================================="
                echo "1. Running Gitleaks Credential Scan"
                echo "=========================================="
                if ! command -v gitleaks &> /dev/null; then
                    curl -sL https://github.com/gitleaks/gitleaks/releases/download/v8.18.2/gitleaks_8.18.2_linux_x64.tar.gz -o gitleaks.tar.gz
                    tar -zxvf gitleaks.tar.gz
                    GITLEAKS_BIN="./gitleaks"
                else
                    GITLEAKS_BIN="gitleaks"
                fi

                $GITLEAKS_BIN detect \\
                  --source . \\
                  --redact \\
                  --report-format json \\
                  --report-path "$WORKSPACE/gitleaks-report.json" \\
                  --exit-code 1

                rm -f gitleaks gitleaks.tar.gz LICENSE README.md
                '''
            }
        }
    }

    post {
        success {
            echo "=========================================="
            echo "CI Pipeline Completed Successfully!"
            echo "=========================================="
        }
        failure {
            echo "Pipeline failed. Check stage logs for details."
        }
    }
}